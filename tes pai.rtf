\});\
container.innerHTML = html;\
\};\
\
window.scaleCardPreview = function() \{\
const parent = document.getElementById('card-preview-container-parent'), wrapper = document.getElementById('card-scale-wrapper');\
if(parent && wrapper) \{\
const pW = parent.clientWidth || parent.getBoundingClientRect().width, pH = parent.clientHeight || parent.getBoundingClientRect().height;\
let scale = Math.min((pW - 32) / 856, (pH - 32) / 540); if (scale > 1) scale = 1; if (scale < 0.2) scale = 0.2;\
