window.simpanPendaftaranMapsi = function() \{\
  if (!window.API_URL || window.API_URL === "URL_APPS_SCRIPT_ANDA_DISINI") \{\
    showToast("Gagal", "URL API Belum dipasang!", "error");\
    return;\
  \}\
\
  const btn = document.getElementById('btn-simpan-pendaftaran');\
  const nama = document.getElementById('reg-nama').value.trim();\
  const sekolah = document.getElementById('reg-sekolah').value.trim();\
  if (!nama) \{ showToast("Validasi", "Nama peserta wajib diisi!", "error"); document.getElementById('reg-nama').focus(); return; \}\
  if (!sekolah) \{ showToast("Validasi", "Asal sekolah wajib diisi!", "error"); document.getElementById('reg-sekolah').focus(); return; \}\
\
  btn.disabled = true;\
  btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Memproses... Mohon tunggu`;\
  btn.classList.add('opacity-90');\
\
  const payload = \{\
    nama: nama,\
    sekolah: sekolah,\
    nisn: document.getElementById('reg-nisn').value,\
    tempat_lahir: document.getElementById('reg-tempat-lahir').value,\
    tgl_lahir: document.getElementById('reg-tgl-lahir').value,\
    jk: document.getElementById('reg-jk').value,\
    lomba: document.getElementById('reg-lomba').value,\
    kategori: document.getElementById('reg-kategori').value\
  \};\
\
  const controller = new AbortController();\
  const timeoutId = setTimeout(() => controller.abort(), 90000);\
  var attempt = 0;\
  var maxAttempt = 3;\
\
  function doSave() \{\
    attempt++;\
    fetch(window.API_URL, \{\
      method: 'POST',\
      headers: \{ 'Content-Type': 'text/plain;charset=utf-8' \},\
      body: JSON.stringify(\{ action: 'registerMapsi', payload: payload \}),\
      signal: controller.signal\
    \})\
    .then(res => \{ clearTimeout(timeoutId); return res.json(); \})\
    .then(res => \{\
      if (res.status === "success" && res.data) \{\
        window.handleSaveSukses(res.data, btn, nama);\
      \} else \{\
        if (res.message && res.message.toLowerCase().indexOf("sibuk") > -1 && attempt < maxAttempt) \{\
          btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Server sibuk, coba lagi ($\{attempt\}/$\{maxAttempt\})...`;\
          setTimeout(doSave, 1500);\
          return;\
        \}\
        btn.disabled = false;\
        btn.classList.remove('opacity-90');\
        btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up mr-2 text-lg"></i> Simpan ke Database`;\
        showToast("Gagal", res.message || "Gagal menyimpan data", "error");\
      \}\
    \})\
    .catch(err => \{\
      clearTimeout(timeoutId);\
      if (attempt < maxAttempt) \{\
        btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Koneksi terganggu, coba lagi ($\{attempt\}/$\{maxAttempt\})...`;\
        setTimeout(doSave, 2000);\
        return;\
      \}\
      btn.disabled = false;\
      btn.classList.remove('opacity-90');\
      btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up mr-2 text-lg"></i> Simpan ke Database`;\
      if (err.name === 'AbortError') \{\
        showToast("Timeout", "Server terlalu lama merespons. Coba lagi.", "error");\
      \} else \{\
        showToast("Error", "Gagal menghubungi server: " + err.message, "error");\
      \}\
    \});\
  \}\
  doSave();\
\};\
\
window.handleSaveSukses = function(data, btn, nama) \{\
  const noInput = document.getElementById('reg-no');\
  noInput.value = data.nomor_peserta;\
  noInput.classList.remove('text-slate-400');\
