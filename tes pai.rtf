window.fetchDatabaseSettings = function() \{\
  if (!window.API_URL || window.API_URL === "URL_APPS_SCRIPT_ANDA_DISINI") \{\
    window.renderGaleri(DUMMY_GALERI);\
    return;\
  \}\
\
  fetch(window.API_URL + "?action=getSettings")\
    .then(res => res.json())\
    .then(res => \{\
      if (res.status === "success" && res.data) \{\
        const d = res.data;\
\
        if (d.counter) \{\
          window.nextPesertaNumber = d.counter.next_number || 1;\
          window.totalPeserta = d.counter.total_peserta || 0;\
          window.updateNomorOtomatis();\
          window.updateLiveCard();\
        \}\
\
        if (d.pengurus) \{\
          if (document.getElementById('cert-sek-nama')) document.getElementById('cert-sek-nama').value = d.pengurus.sekretaris || "BUDI, M.Pd";\
          if (document.getElementById('cert-sek-nip')) document.getElementById('cert-sek-nip').value = d.pengurus.nip_sekretaris || "198502022010011004";\
          if (document.getElementById('cert-ketua-nama')) document.getElementById('cert-ketua-nama').value = d.pengurus.ketua || "AHMAD FAUZI, S.Pd.I";\
          if (document.getElementById('cert-ketua-nip')) document.getElementById('cert-ketua-nip').value = d.pengurus.nip_ketua || "198001012005011003";\
        \}\
        if (d.beranda) \{\
          if (d.beranda.hero_title) document.getElementById('dynamic-hero-title').innerHTML = d.beranda.hero_title;\
          if (d.beranda.hero_subtitle) document.getElementById('dynamic-hero-subtitle').innerHTML = d.beranda.hero_subtitle;\
          if (d.beranda.visi) document.getElementById('dynamic-visi-text').innerHTML = d.beranda.visi;\
          if (d.beranda.misi) \{\
            let h = '<ul class="space-y-4 text-sm sm:text-base text-slate-600 font-medium">';\
            d.beranda.misi.split('\\n').forEach(i => \{\
              if (i.trim() !== '') h += `<li class="flex items-start"><i class="fa-solid fa-circle-check text-primary-500 mt-1 mr-3 flex-shrink-0 text-lg"></i> <span>$\{i.trim()\}</span></li>`;\
            \});\
            document.getElementById('dynamic-misi-list').innerHTML = h + '</ul>';\
          \}\
        \}\
        if (d.tentang) \{\
          if (d.tentang.title) document.getElementById('dynamic-tentang-title').innerText = d.tentang.title;\
          if (d.tentang.description) \{\
            let h = '';\
            d.tentang.description.split('\\n\\n').forEach(p => \{\
              if (p.trim() !== '') h += h === '' ? `<p class="font-medium text-brand-text text-base sm:text-lg">$\{p.trim()\}</p>` : `<p>$\{p.trim()\}</p>`;\
            \});\
            document.getElementById('dynamic-tentang-desc').innerHTML = h;\
          \}\
          if (d.tentang.image_url) document.getElementById('dynamic-tentang-image').src = d.tentang.image_url;\
          if (d.tentang.stat_anggota) document.getElementById('dynamic-stat-anggota').innerHTML = `$\{d.tentang.stat_anggota\}<span class="text-2xl text-primary-500">+</span>`;\
          if (d.tentang.stat_sekolah) document.getElementById('dynamic-stat-sekolah').innerText = d.tentang.stat_sekolah;\
          if (d.tentang.stat_persen) document.getElementById('dynamic-stat-persen').innerHTML = `$\{d.tentang.stat_persen\}<span class="text-2xl text-emerald-400">%</span>`;\
        \}\
        if (d.galeri && Array.isArray(d.galeri)) window.renderGaleri(d.galeri);\
        else window.renderGaleri(DUMMY_GALERI);\
      \}\
