window.startAutoRefreshCounter = function() \{\
  if (window._counterInterval) clearInterval(window._counterInterval);\
  window._counterInterval = setInterval(function() \{\
    var page = document.getElementById('page-pendaftaran');\
    if (page && !page.classList.contains('hidden')) \{\
      var panelSukses = document.getElementById('panel-sukses-pendaftaran');\
      var sedangSukses = panelSukses && !panelSukses.classList.contains('hidden');\
      if (!sedangSukses) \{\
        window.refreshNomorDariServer();\
      \}\
    \}\
  \}, 5000);\
\};\
