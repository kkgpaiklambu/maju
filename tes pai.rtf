window.resetFormPendaftaran = function() \{\
  const panel = document.getElementById('panel-sukses-pendaftaran');\
  if (panel) panel.classList.add('hidden');\
\
  document.getElementById('reg-nama').value = "";\
  document.getElementById('reg-nisn').value = "";\
  document.getElementById('reg-tempat-lahir').value = "";\
  document.getElementById('reg-tgl-lahir').value = "";\
\
  const btn = document.getElementById('btn-simpan-pendaftaran');\
  if (btn) \{\
    btn.disabled = false;\
    btn.classList.remove('opacity-90');\
    btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up mr-2 text-lg"></i> Simpan ke Database`;\
  \}\
\
  window.refreshNomorDariServer();\
  showToast("Siap", "Form siap untuk peserta berikutnya.");\
\};\
\
window.showToast = function(title, message, type = "success") \{\
const container = document.getElementById('toast-container'); if (!container) return; const toast = document.createElement('div');\
toast.className = `p-4 rounded-xl shadow-floating border text-xs font-bold flex items-start space-x-3 transition-all duration-300 transform translate-x-12 opacity-0 pointer-events-auto w-full sm:max-w-sm $\{type === "error" ? "bg-red-50 border-red-200 text-red-800" : "bg-white border-white text-brand-text"\}`;\
toast.innerHTML = `<div class="mt-0.5 flex-shrink-0"><i class="fa-solid $\{type === 'error' ? 'fa-triangle-exclamation text-red-500' : 'fa-circle-check text-primary-500'\} text-lg"></i></div><div class="flex-1 min-w-0"><h5 class="font-black text-sm mb-0.5">$\{title\}</h5><p class="text-[10px] text-slate-500 line-clamp-2 font-medium">$\{message\}</p></div>`;\
container.appendChild(toast); setTimeout(() => toast.classList.remove('translate-x-12', 'opacity-0'), 50); setTimeout(() => \{ toast.classList.add('translate-x-12', 'opacity-0'); setTimeout(() => toast.remove(), 300); \}, 4500);\
\};\
\
let activeSlide = 1;\
setInterval(() => \{\
const s1 = document.getElementById('slide-1'), s2 = document.getElementById('slide-2'); if(!s1 || !s2) return;\
if (activeSlide === 1) \{ s1.className = "absolute inset-0 transition-all duration-700 ease-in-out transform opacity-0 scale-95 -translate-x-full hero-slide flex items-center justify-center px-4"; s2.className = "absolute inset-0 transition-all duration-700 ease-in-out transform opacity-100 scale-100 hero-slide flex items-center justify-center px-4"; activeSlide = 2; \}\
else \{ s2.className = "absolute inset-0 transition-all duration-700 ease-in-out transform opacity-0 scale-95 translate-x-full hero-slide flex items-center justify-center px-4"; s1.className = "absolute inset-0 transition-all duration-700 ease-in-out transform opacity-100 scale-100 hero-slide flex items-center justify-center px-4"; activeSlide = 1; \}\
\}, 5000);\
\
window.onload = () => \{\
  fetchDatabaseSettings();\
  setTimeout(() => \{ window.scaleCardPreview(); window.resizeCertificatePreview(); \}, 200);\
  cycleNews(activeNewsIndex); newsTimer = setInterval(nextNews, 5000);\
  window.updateNomorOtomatis(); window.updateLiveCard(); window.updateLiveCertificate();\
  setInterval(window.refreshNomorDariServer, 30000);\
  window.startAutoRefreshCounter();\
\};\
\
window.adminClickCount = 0; window.adminClickTimer = null; window.adminOverlayEl = null;\
window.handleAdminClick = function() \{\
if (!window.adminOverlayEl) \{\
window.adminOverlayEl = document.createElement('div'); window.adminOverlayEl.className = 'fixed inset-0 z-[10000] bg-brand-text/80 backdrop-blur-sm flex items-center justify-center hidden p-4';\
window.adminOverlayEl.innerHTML = `<div class="bg-white p-6 rounded-3xl border border-slate-200 w-full max-w-sm text-slate-800 space-y-5 shadow-2xl"><h3 class="font-black text-lg border-b border-slate-100 pb-3 text-brand-text"><i class="fa-solid fa-gears text-primary-500 mr-2"></i> Pengaturan API & Counter</h3><div class="space-y-2"><div><label class="block text-[10px] text-slate-500 font-bold uppercase mb-2">Google Apps Script URL</label><input type="text" id="set-api-url" value="$\{window.API_URL\}" placeholder="Paste URL deployment /exec di sini" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs text-slate-800 focus:outline-none focus:border-primary-500 font-mono"></div></div><div class="flex space-x-3"><button onclick="saveAdminAPI()" class="flex-1 bg-primary-600 text-white py-3 rounded-xl text-xs font-black transition-transform hover:-translate-y-1 shadow-md">Simpan</button><button onclick="window.adminOverlayEl.classList.add('hidden')" class="bg-slate-100 hover:bg-slate-200 text-brand-text px-4 py-3 rounded-xl text-xs font-bold transition-colors">Batal</button></div><div class="border-t border-slate-100 pt-4 mt-2"><label class="block text-[10px] text-slate-500 font-bold uppercase mb-2">Reset Nomor Peserta ke:</label><div class="flex space-x-2"><input type="number" id="reset-counter-val" value="1" min="1" class="w-20 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs focus:outline-none focus:border-primary-500 font-mono"><button onclick="resetCounterDariWeb(parseInt(document.getElementById('reset-counter-val').value))" class="flex-1 bg-red-500 hover:bg-red-600 text-white py-2 rounded-xl text-xs font-black transition-all shadow-md">Reset Counter</button></div><p class="text-[9px] text-slate-400 mt-1 italic">\uc0\u9888 \u65039  Reset nomor peserta dari web.</p></div></div>`;\
document.body.appendChild(window.adminOverlayEl);\
\}\
window.adminClickCount++;\
if (window.adminClickCount >= 3) \{ window.adminOverlayEl.classList.remove('hidden'); window.adminClickCount = 0; \}\
clearTimeout(window.adminClickTimer); window.adminClickTimer = setTimeout(() => \{ window.adminClickCount = 0; \}, 2000);\
\};\
\
window.saveAdminAPI = function() \{ const val = document.getElementById('set-api-url').value.trim(); document.cookie = "MAPSI_API_URL=" + val + "; expires=Fri, 31 Dec 2035 23:59:59 GMT; path=/"; window.API_URL = val; fetchDatabaseSettings(); window.refreshNomorDariServer(); showToast("Sukses", "Tautan API diperbarui & disimpan permanen!"); window.adminOverlayEl.classList.add('hidden'); loadArsipSertifikat(); \};\
\
// ============================================================\
// RESET COUNTER DARI WEB (untuk admin)\
// ============================================================\
window.resetCounterDariWeb = function(nextNumber) \{\
  if (!window.API_URL) return alert("API URL belum diset!");\
  var val = nextNumber || 1;\
  if (!confirm("\uc0\u9888 \u65039  YAKIN reset counter ke " + val + "?\\n\\nPendaftaran berikutnya mulai dari nomor " + val + ".")) return;\
  \
  fetch(window.API_URL, \{\
    method: 'POST',\
    headers: \{ 'Content-Type': 'text/plain;charset=utf-8' \},\
    body: JSON.stringify(\{ action: 'resetCounter', payload: \{ value: val \} \})\
  \})\
  .then(res => res.json())\
  .then(res => \{\
    if (res.status === "success") \{\
      alert("\uc0\u9989  Counter berhasil direset ke " + val + "!\\n\\nHalaman akan refresh otomatis...");\
      if ('caches' in window) \{\
        caches.keys().then(names => \{\
          names.forEach(name => caches.delete(name));\
        \});\
      \}\
      window.refreshNomorDariServer();\
      setTimeout(() => window.location.reload(true), 1000);\
    \} else \{\
      alert("\uc0\u10060  Gagal: " + res.message);\
    \}\
  \})\
  .catch(err => alert("\uc0\u10060  Error: " + err.message));\
\};\
\
document.addEventListener('keydown', e => \{ if(e.altKey && e.key.toLowerCase() === 'a') \{ e.preventDefault(); if(!window.adminOverlayEl) \{ window.handleAdminClick(); window.handleAdminClick(); window.handleAdminClick(); \} else \{ window.adminOverlayEl.classList.toggle('hidden'); \} \} \});\
</script>\
</body>\
</html>}