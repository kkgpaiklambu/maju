\
window.refreshNomorDariServer = function() \{\
  if (!window.API_URL || window.API_URL === "URL_APPS_SCRIPT_ANDA_DISINI") return Promise.resolve();\
  \
  // Cache-busting TOTAL: timestamp + random + header no-cache\
  var url = window.API_URL + "?action=getCounter&_t=" + Date.now() + "&_r=" + Math.random();\
  \
  return fetch(url, \{ \
    cache: 'no-store',\
    headers: \{\
      'Cache-Control': 'no-cache, no-store, must-revalidate',\
      'Pragma': 'no-cache'\
    \}\
  \})\
    .then(res => res.json())\
    .then(res => \{\
      if (res.status === "success" && res.data) \{\
        window.nextPesertaNumber = res.data.next_number || 1;\
        window.totalPeserta = res.data.total_peserta || 0;\
        window.updateNomorOtomatis();\
        window.updateLiveCard();\
        console.log('\uc0\u9989  Counter di-refresh:', res.data);\
      \}\
    \})\
    .catch(err => \{\
      console.warn("\uc0\u9888 \u65039  Gagal refresh counter, retry 2s...", err);\
      setTimeout(window.refreshNomorDariServer, 2000);\
    \});\
\};\
