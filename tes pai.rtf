        fetch(window.API_URL, \{\
          method: 'POST',\
          headers: \{ 'Content-Type': 'text/plain;charset=utf-8' \},\
          body: JSON.stringify(\{ action: 'uploadIDCard', payload: payload \})\
        \})\
        .then(res => res.json())\
        .then(res => \{\
          if (res.status === "success" && res.data) resolve(res.data);\
          else reject(new Error(res.message || "Gagal upload"));\
        \})\
        .catch(err => reject(err));\
      \})\
      .catch(err => reject(err));\
  \});\
\};\
\
