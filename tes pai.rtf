window.uploadIDCardKeDrive = function(pesertaData, btnElement) \{\
  return new Promise((resolve, reject) => \{\
    if (!window.API_URL) return reject(new Error("API URL belum diset"));\
\
    window.createPreciseImageFromDOM('card-canvas-container', 856, 540)\
      .then(imgDataUrl => \{\
        const payload = \{\
          no_peserta: pesertaData.nomor_peserta,\
          nama: pesertaData.nama,\
          sekolah: pesertaData.sekolah,\
          lomba: pesertaData.lomba,\
          kategori: pesertaData.kategori,\
          imageDataUrl: imgDataUrl\
