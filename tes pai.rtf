        <button onclick="resetFormPendaftaran()" class="bg-white border-2 border-slate-300 hover:bg-slate-50 text-slate-700 font-bold py-3 px-3 rounded-xl text-xs transition-all shadow-sm flex items-center justify-center space-x-2">\
